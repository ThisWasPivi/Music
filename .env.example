# Spotify app credentials from https://developer.spotify.com/dashboard.
# Never commit the filled-in .env: it is gitignored.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must match a Redirect URI registered on the Spotify app, e.g.
# http://127.0.0.1:8888/callback (loopback IP, not "localhost").
SPOTIFY_REDIRECT_URI=
# Written by `pnpm auth`. Expires six months after authorization.
SPOTIFY_REFRESH_TOKEN=
